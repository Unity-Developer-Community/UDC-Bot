{
  // Requires the C# extension (ms-dotnettools.csharp), recommended in extensions.json.
  // See tasks.json for why the bot is built for net8.0 and run with DOTNET_ROLL_FORWARD.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch bot",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build and check settings",
      "program": "${workspaceFolder}/DiscordBot/bin/Debug/net8.0/DiscordBot.dll",
      "args": [],
      // The bot reads Settings/, Assets/ and SERVER/ relative to this folder.
      "cwd": "${workspaceFolder}/DiscordBot",
      "env": {
        "DOTNET_ROLL_FORWARD": "Major"
      },
      // The integrated terminal shows the bot's coloured log output.
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": "Attach to bot",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickProcess}"
    }
  ]
}
