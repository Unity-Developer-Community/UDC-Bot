{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C#: Debug DiscordBot",
            "type": "dotnet",
            "request": "launch",
            "projectPath": "${workspaceFolder}/DiscordBot/DiscordBot.csproj"
        },
        {
            "name": "C#: Attach to .NET process",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:pickProcess}"
        }
    ]
}
