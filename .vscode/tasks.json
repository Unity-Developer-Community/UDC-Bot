{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "dotnet: restore solution",
            "type": "process",
            "command": "dotnet",
            "args": [
                "restore",
                "DiscordBot.sln"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "dotnet: build solution",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "DiscordBot.sln"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "dotnet: run bot",
            "type": "process",
            "command": "dotnet",
            "args": [
                "run",
                "--project",
                "DiscordBot/DiscordBot.csproj"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "dotnet: watch bot",
            "type": "process",
            "command": "dotnet",
            "args": [
                "watch",
                "--project",
                "DiscordBot/DiscordBot.csproj",
                "run"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "dotnet: test solution",
            "type": "process",
            "command": "dotnet",
            "args": [
                "test",
                "DiscordBot.sln"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "test",
                "isDefault": true
            }
        },
        {
            "label": "dotnet: publish bot",
            "type": "process",
            "command": "dotnet",
            "args": [
                "publish",
                "DiscordBot/DiscordBot.csproj",
                "--configuration",
                "Release"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "docker: start PostgreSQL",
            "type": "process",
            "command": "docker",
            "args": [
                "compose",
                "up",
                "--detach",
                "db"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
