{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/DiscordBot/DiscordBot.csproj",
        "--configuration",
        "Debug",
        "--output",
        "${workspaceFolder}/DiscordBot/bin/vscode",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "publish",
      "command": "dotnet",
      "type": "process",
      "args": [
        "publish",
        "${workspaceFolder}/DiscordBot/DiscordBot.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "watch",
      "command": "dotnet",
      "type": "process",
      "args": [
        "watch",
        "--project",
        "${workspaceFolder}/DiscordBot/DiscordBot.csproj",
        "run"
      ],
      "options": {
        "cwd": "${workspaceFolder}/DiscordBot"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "run",
      "command": "dotnet",
      "type": "process",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/DiscordBot/DiscordBot.csproj"
      ],
      "options": {
        "cwd": "${workspaceFolder}/DiscordBot"
      },
      "problemMatcher": "$msCompile"
    }
  ]
}
