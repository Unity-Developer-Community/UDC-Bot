<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- The pod has half a CPU and 768 MiB: a background GC thread buys nothing, and see ConserveMemory below. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compact and give memory back when the heap is fragmented, instead of keeping it after a spike (docs/decisions.md D8). -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Insight.Database" Version="8.0.6" />
    <PackageReference Include="Insight.Database.Providers.PostgreSQL" Version="8.0.6" />
    <PackageReference Include="HtmlAgilityPack" Version="1.13.0" />
    <PackageReference Include="Discord.Net" Version="3.20.1" />
    <PackageReference Include="Magick.NET-Q8-x64" Version="14.15.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="System.ServiceModel.Syndication" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="SERVER\images\profiles" />
  </ItemGroup>
</Project>
