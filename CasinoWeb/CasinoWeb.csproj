<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <UserSecretsId>63363f64-e0ae-4418-8ff5-0af965df81ac</UserSecretsId>
    <!-- Lets a machine that only has a newer ASP.NET Core runtime run it; the aspnet:8.0 image has the exact one. -->
    <RollForward>Major</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <!-- 8.3.0 is the newest release that targets net8.0; 9.x and later target net9.0 and above. -->
    <PackageReference Include="AspNet.Security.OAuth.Discord" Version="8.3.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DiscordBot\DiscordBot.csproj" />
  </ItemGroup>
</Project>
